# Copia este archivo como ".env" en la carpeta PADRE del proyecto
# (la que contiene CrochetLab_Php), así queda fuera de la carpeta pública.
#
#   Copy-Item env.ejemplo ..\.env
#   notepad ..\.env

# URL pública de la aplicación (sin barra final). Se usa en los enlaces de los correos.
# Si corre en una subcarpeta (XAMPP), inclúyela: http://localhost/CrochetLab_Php
APP_URL=http://localhost:8000

# "archivo": guarda los correos en la carpeta correos_salida (para desarrollo, sin internet)
# "smtp"   : envía de verdad usando la cuenta de Gmail de abajo
MAIL_MODO=archivo

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=crochetlab.proyecto@gmail.com
# Contraseña de APLICACIÓN de 16 caracteres (NO la contraseña normal de Gmail)
MAIL_PASS=
MAIL_FROM_NAME=CrochetLab

# true = los roles con permiso de gestionar usuarios deben activar la verificación en dos pasos
ADMIN_REQUIERE_2FA=true

# ───────── Base de datos (aquí van las credenciales, NO en el código) ─────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_login
DB_USER=postgres
DB_PASS=
# Cifrado de la conexión con la base: disable | prefer | require | verify-full
# En el servidor (VM) usa "require": el tráfico web -> base de datos viaja cifrado con TLS.
DB_SSLMODE=prefer
# true = muestra el detalle de los errores de conexión (solo para desarrollo)
APP_DEBUG=false

# ───────── Cifrado de datos sensibles (AES-256-GCM) ─────────
# Genera la clave con:  php database/generar_clave.php
# y pega aquí la línea completa. Guarda una copia segura: sin ella los datos cifrados no se recuperan.
# Cada equipo/servidor que use la MISMA base de datos debe tener la MISMA clave.
CIFRADO_CLAVE=

# ───────── Respaldos automáticos (database/respaldo.php) ─────────
# Carpeta del USB o disco externo donde se guardan los respaldos cifrados (.dump.enc)
# Windows: RESPALDO_DESTINO=E:\respaldos     Linux: RESPALDO_DESTINO=/media/usb/respaldos
RESPALDO_DESTINO=
# Cuántos respaldos conservar (los más viejos se borran)
RESPALDO_CONSERVAR=14
# Opcional: clave propia para los respaldos (si se deja vacía se usa CIFRADO_CLAVE)
RESPALDO_CLAVE=
# Opcional: ruta de pg_dump / pg_restore si no están en el PATH (Windows)
# PG_DUMP_RUTA=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# PG_RESTORE_RUTA=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe
